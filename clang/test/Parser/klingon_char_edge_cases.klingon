// RUN: %clang_cc1 -fsyntax-only -x klingon -verify %s

// Test edge cases for backtick character literals in Klingon mode
// Note: Backtick literals have only an opening backtick, no closing delimiter

mI' test_incomplete_char() {
  // Incomplete at end of line - should error
  qIt c2 = ` // expected-error {{incomplete backtick character literal}}
  // expected-error@-1 {{expected ';' after expression}}
  chegh 0;
}

mI' test_escaped_backtick() {
  qIt backtick = `\`;  // Escaped backtick - should work
  chegh 0;
}

mI' test_all_escapes() {
  qIt newline = `\n;
  qIt tab = `\t;
  qIt carriage = `\r;
  qIt backslash = `\\;
  qIt single_quote = `\';
  qIt double_quote = `\";
  qIt question = `\?;
  qIt alert = `\a;
  qIt backspace = `\b;
  qIt formfeed = `\f;
  qIt vtab = `\v;
  qIt null_char = `\0;
  qIt octal = `\101;  // 'A'
  qIt hex = `\x41;    // 'A'
  qIt space = `\s;    // Space using \s escape
  chegh 0;
}

mI' main() {
  chegh 0;
}
