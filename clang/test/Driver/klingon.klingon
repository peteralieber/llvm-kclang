// RUN: %clang -x klingon -fsyntax-only %s -### 2>&1 | FileCheck %s --check-prefix=KLINGON
// RUN: %clang -fsyntax-only %s -### 2>&1 | FileCheck %s --check-prefix=KLINGON

// KLINGON: "-x" "klingon"

// Test that Klingon keywords are recognized
mI qoq(mI a, mI b) {
  HIja (a > b) {
    chegh a;
  } ghobe {
    chegh b;
  }
}

mI main() {
  mI x = 10;
  mI y = 20;
  mI result = qoq(x, y);
  chegh 0;
}
